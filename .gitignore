# =========================================================
# Orchestrion — monorepo .gitignore
# Place at the repo root: D:\ProjectDAAD\Orchestrion\Orchestrion\.gitignore
# =========================================================

# ---------- Python / backend ----------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/

# test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---------- Node / frontend ----------
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# npm / build logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- IDE ----------
.idea/
.vscode/
*.iml

# ---------- OS noise ----------
Thumbs.db
Desktop.ini
.DS_Store

# ---------- Environment / secrets ----------
.env
.env.*
!.env.example

# ---------- Project-specific ----------
# Licensed standards & peer code live OUTSIDE this repo by architecture
# (../standards/, ../reference/) — listed here as a safety net only:
standards/
reference/
*.pdf

# runtime artifacts
*.log
logs/
*.sqlite
*.sqlite3
*.db
